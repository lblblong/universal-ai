{
  "name": "universal-ai",
  "version": "3.2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "typings": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "NODE_USE_ENV_PROXY=1 vitest run",
    "test:watch": "NODE_USE_ENV_PROXY=1 vitest",
    "test:app-form": "NODE_USE_ENV_PROXY=1 vitest run --config vitest.probe.config.ts",
    "test:reasoning": "NODE_USE_ENV_PROXY=1 vitest run --config vitest.probe.config.ts test/probes/reasoning-stream.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsdown": "^0.21.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
